# Production Environment Configuration Template
# Copy this file to .env and fill in the production values

# Supabase Configuration (REQUIRED)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-production-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-production-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Frontend Configuration (REQUIRED)
FRONTEND_URL=https://your-production-domain.com

# Application Settings
DEBUG=false
SECRET_KEY=your-long-random-secret-key-min-32-chars

# Optional: Render Deployment
RENDER_DEPLOYMENT_URL=https://your-render-app.onrender.com

# Optional: Payment URLs
RETURN_URL=https://your-production-domain.com/payment-return
WEBHOOK_URL=https://your-api.onrender.com/api/webhooks/payment

# Logging Level (INFO, WARNING, ERROR, DEBUG)
LOG_LEVEL=INFO

# CORS Settings (semicolon separated for multiple origins)
ALLOWED_HOSTS=your-production-domain.com;api.your-production-domain.com

# Database
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Security
ENABLE_HSTS=true
MAX_REQUEST_SIZE=10485760

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=3600
