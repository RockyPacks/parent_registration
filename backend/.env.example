# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Experian PVS-E REST API
# Obtain credentials from Experian Access Management (case CAS-3097527).
# Store received values in your secrets manager — never commit real values here.
EXPERIAN_UAT_BASE_URL=https://apis-uat.experian.co.za:9443/PvseService
EXPERIAN_PROD_BASE_URL=https://apis.experian.co.za:9443/PvseService
EXPERIAN_USERNAME=
EXPERIAN_PASSWORD=
EXPERIAN_SUBSCRIBER_CODE=35052-REA
EXPERIAN_ACCURACY_THRESHOLD=65
EXPERIAN_TIMEOUT_SECONDS=60
EXPERIAN_ENVIRONMENT=uat

# Payment URLs (optional)
RETURN_URL=https://your-payment-return-url.com
WEBHOOK_URL=https://your-payment-webhook-url.com

# Application Settings
FRONTEND_URL=https://your-frontend-domain.com
RENDER_DEPLOYMENT_URL=https://your-render-backend-url.com

# Environment
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=your-secret-key-here
